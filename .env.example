# pi-sd-backup configuration — copy to .env on the Pi and fill in real values.
# Keep .env OUT of git (it is gitignored). Never commit real UUIDs.
#
# Find a card's filesystem UUID with:  sudo blkid
# Pick the UUID of any partition on the card; the script resolves it to the
# whole-disk device (e.g. /dev/sdb) automatically, so a re-plug or reboot that
# renames the device can never send dd to the wrong disk.

# SOURCE_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# DEST_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional overrides:
# LOG_LEVEL=INFO
# LOG_FILE=/var/log/pi-sd-backup.log
